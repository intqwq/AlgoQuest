FROM gcc:14-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 time \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin runner
COPY runner/submission_runner.py /opt/algoquest/submission_runner.py
COPY runner/memory_baseline.cpp /opt/algoquest/memory_baseline.cpp
RUN g++ -std=gnu++14 -O2 -pipe \
      -o /opt/algoquest/memory_baseline \
      /opt/algoquest/memory_baseline.cpp \
    && rm /opt/algoquest/memory_baseline.cpp \
    && chmod 0555 \
      /opt/algoquest/submission_runner.py \
      /opt/algoquest/memory_baseline

WORKDIR /workspace

LABEL org.opencontainers.image.title="AlgoQuest C++14 runner"
