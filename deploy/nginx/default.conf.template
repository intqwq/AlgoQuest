map $http_x_forwarded_proto $algoquest_forwarded_proto {
    default $scheme;
    https https;
}

limit_req_zone $binary_remote_addr zone=algoquest_auth:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=algoquest_guest:10m rate=10r/m;

server {
    listen 80;
    server_name _;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Docker's embedded DNS server tracks service IP changes after containers
    # are recreated. proxy_pass uses variables so Nginx resolves each hostname
    # through this resolver instead of pinning the startup-time container IP.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream "${API_UPSTREAM}";
    set $web_upstream "${WEB_UPSTREAM}";

    # Route handlers still enforce their own tighter limits.
    client_max_body_size 1m;
    limit_req_status 429;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/v1/auth/ {
        limit_req zone=algoquest_auth burst=10 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $algoquest_forwarded_proto;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }

    location = /api/v1/sessions {
        limit_req zone=algoquest_guest burst=5 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $algoquest_forwarded_proto;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }

    # Metrics stay on the private service network for Prometheus scraping.
    location = /api/metrics {
        return 404;
    }

    # Problem setters may upload up to 50 bounded test pairs plus a std source.
    # Every public read and code submission keeps the smaller server-wide limit.
    location ~ ^/api/v1/oj/(problems$|drafts/[0-9a-f-]{36}$) {
        client_max_body_size 8m;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $algoquest_forwarded_proto;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $algoquest_forwarded_proto;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }

    location / {
        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $algoquest_forwarded_proto;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
}
