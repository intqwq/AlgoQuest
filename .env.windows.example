# Copy to .env.windows. The Windows deployment script fills both CHANGE_ME values.
POSTGRES_DB=algoquest
POSTGRES_USER=algoquest
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgres://algoquest:CHANGE_ME_DATABASE_PASSWORD@db:5432/algoquest

JUDGE_API_TOKEN=CHANGE_ME_JUDGE_TOKEN
JUDGE_RUNNER_IMAGE=algoquest-runner:cpp14
JUDGE_MAX_PARALLEL=2
JUDGE_QUEUE_CAPACITY=1000
JUDGE_WORK_VOLUME=algoquest-judge-work
JUDGE_CACHE_VOLUME=algoquest-judge-cache

WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
API_BIND_ADDRESS=127.0.0.1
API_PORT=8787
JUDGE_BIND_ADDRESS=127.0.0.1
JUDGE_PORT=8788
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432

# Defaults for a single Windows machine. Replace with HTTPS URLs for split hosts.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_UPSTREAM=http://api:8787
WEB_UPSTREAM=http://web:3000
JUDGE_API_URL=http://judge:8788
API_ALLOWED_ORIGIN=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080

# Windows development defaults: Cloudflare's official always-pass test keys
# and verification/reset links written to `docker compose logs api`.
AUTH_EMAIL_MODE=log
RESEND_API_KEY=
RESEND_FROM_EMAIL=AlgoQuest@intqwq.com
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=
SITE_OWNER_EMAIL=
JUDGE_COOLDOWN_MS=5000
