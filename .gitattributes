* text=auto

# Scripts copied into Linux containers must never inherit Windows CRLF endings.
*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf

# Keep deployment and configuration files portable across Windows and Linux.
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.example text eol=lf
